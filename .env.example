# ATS Resume Scorer Configuration

# Groq API Key (Required for AI Parsing & Feedback)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Supabase Configuration (Optional - for User Authentication and History)
# Get these from your Supabase project dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Optional: Redirect URL for OAuth
AUTH_REDIRECT_URL=http://localhost:8501
